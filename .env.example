# Required
# Pooled Neon URL is fine for simple queries; the app prefers DATABASE_URL_UNPOOLED
# for Prisma interactive transactions (inventory locks, reservations, etc.).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# Required for interactive transactions / migrations (non-pooler host, no -pooler)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional — Render/Railway sets PORT automatically
PORT=3000

# Optional — extra frontend origins (comma-separated)
# localhost:8000 is always allowed by default
# Example: https://my-app.vercel.app
CORS_ORIGIN=

# Optional — Neon Object Storage (required for payment screenshot uploads)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=us-east-2
# PAYMENT_SCREENS_BUCKET=payment-screens
# PAYMENT_SCREENSHOT_MAX_BYTES=204800  # optional; default 200 KB if unset
