# Required
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# Optional — Render sets PORT automatically
PORT=3000

# Optional — extra frontend origins (comma-separated)
# localhost:8000 is always allowed by default
# Example: https://my-app.vercel.app
CORS_ORIGIN=

# Optional — Neon direct URL (useful for migrations)
DATABASE_URL_UNPOOLED=

# Optional — Neon Object Storage (only if using file uploads)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
