generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER_SERVICE
  BRANCH_EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  BOOK
  CARD
}

enum ProductStatus {
  UPCOMING
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum AcademicYearStatus {
  ACTIVE
  INACTIVE
}

enum ReservationStatus {
  PENDING
  WAITING_FOR_STOCK
  READY
  DELIVERED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
}

enum PaymentMethod {
  CASH
  WALLET
  INSTAPAY
}

enum StockMovementType {
  STOCK_IN
  SALE
  RESERVATION
  RESERVATION_RELEASE
  RETURN
  DAMAGED
  ADJUSTMENT
}

enum StudentLogAction {
  UPDATED
  DEACTIVATED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole
  status       UserStatus @default(ACTIVE)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdStudents     Student[]       @relation("StudentCreatedBy")
  studentLogs         StudentLog[]
  stockMovements      StockMovement[]
  sales               Sale[]          @relation("SaleCreatedBy")
  reservationsCreated Reservation[]   @relation("ReservationCreatedBy")
  payments            Payment[]
  refunds             Refund[]
  expenses            Expense[]
  returnsCreated      ProductReturn[] @relation("ReturnCreatedBy")
  exchangesCreated    Exchange[]      @relation("ExchangeCreatedBy")

  @@index([branchId])
  @@index([role])
  @@index([status])
}

model Branch {
  id      String       @id @default(uuid())
  name    String
  address String?
  phone   String?
  status  BranchStatus @default(ACTIVE)

  users          User[]
  inventories    Inventory[]
  sales          Sale[]
  reservations   Reservation[]
  stockMovements StockMovement[]
  expenses       Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Teacher {
  id     String        @id @default(uuid())
  name   String
  status TeacherStatus @default(ACTIVE)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudyYear {
  id   String @id @default(uuid())
  name String @unique

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id     String             @id @default(uuid())
  name   String             @unique
  status AcademicYearStatus @default(INACTIVE)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id     String        @id @default(uuid())
  name   String
  phone  String?
  status StudentStatus @default(ACTIVE)

  createdById String?
  createdBy   User?   @relation("StudentCreatedBy", fields: [createdById], references: [id])

  sales        Sale[]
  reservations Reservation[]
  logs         StudentLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([phone])
  @@index([status])
}

model StudentLog {
  id        String           @id @default(uuid())
  studentId String
  action    StudentLogAction

  oldData Json
  newData Json?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([createdById])
  @@index([createdAt])
}

model Product {
  id               String      @id @default(uuid())
  name             String
  type             ProductType
  teacherId        String
  studyYearId      String?
  academicYearId   String
  purchasePrice    Decimal     @db.Decimal(12, 2)
  sellingPrice     Decimal     @db.Decimal(12, 2)
  profitPercentage Decimal     @db.Decimal(5, 2)

  reservationAllowed Boolean  @default(false)
  reservationPrice   Decimal? @db.Decimal(12, 2)

  status ProductStatus @default(UPCOMING)

  teacher      Teacher      @relation(fields: [teacherId], references: [id])
  studyYear    StudyYear?   @relation(fields: [studyYearId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  inventories    Inventory[]
  saleItems      SaleItem[]
  reservations   Reservation[]
  stockMovements StockMovement[]
  exchanges      Exchange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([studyYearId])
  @@index([academicYearId])
  @@index([status])
  @@index([reservationAllowed])
}

model Inventory {
  id        String @id @default(uuid())
  branchId  String
  productId String

  physicalQuantity Int @default(0)
  reservedQuantity Int @default(0)

  lowStockThreshold Int @default(0)

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([productId])
  @@index([branchId])
}

model StockMovement {
  id           String            @id @default(uuid())
  branchId     String
  productId    String
  movementType StockMovementType

  physicalQuantityChange Int @default(0)
  reservedQuantityChange Int @default(0)

  referenceId String?
  note        String?

  createdById String
  createdAt   DateTime @default(now())

  branch    Branch  @relation(fields: [branchId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([branchId])
  @@index([productId])
  @@index([movementType])
  @@index([createdAt])
  @@index([referenceId])
}

model Sale {
  id          String     @id @default(uuid())
  studentId   String
  branchId    String
  createdById String
  totalAmount Decimal    @db.Decimal(12, 2)
  status      SaleStatus @default(COMPLETED)

  reservationId String? @unique

  student   Student @relation(fields: [studentId], references: [id])
  branch    Branch  @relation(fields: [branchId], references: [id])
  createdBy User    @relation("SaleCreatedBy", fields: [createdById], references: [id])

  reservation Reservation? @relation(fields: [reservationId], references: [id])

  items     SaleItem[]
  payments  Payment[]
  returns   ProductReturn[]
  exchanges Exchange[]
  refunds   Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([branchId])
  @@index([createdById])
  @@index([createdAt])
}

model SaleItem {
  id        String @id @default(uuid())
  saleId    String
  productId String

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  returnedQuantity Int @default(0)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  returnItems ReturnItem[]
  exchanges   Exchange[]

  @@index([saleId])
  @@index([productId])
}

model Reservation {
  id                String @id @default(uuid())
  reservationNumber String @unique

  studentId   String
  branchId    String
  productId   String
  createdById String

  quantity Int

  reservationPrice Decimal @db.Decimal(12, 2)
  totalAmount      Decimal @db.Decimal(12, 2)
  paidAmount       Decimal @default(0) @db.Decimal(12, 2)

  status ReservationStatus @default(PENDING)

  student   Student @relation(fields: [studentId], references: [id])
  branch    Branch  @relation(fields: [branchId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation("ReservationCreatedBy", fields: [createdById], references: [id])

  payments Payment[]
  refunds  Refund[]
  sale     Sale?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([branchId])
  @@index([productId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id     String        @id @default(uuid())
  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod

  proofReference String?

  saleId        String?
  reservationId String?

  createdById String

  sale        Sale?        @relation(fields: [saleId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  createdBy   User         @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([reservationId])
  @@index([createdById])
  @@index([createdAt])
}

model ProductReturn {
  id          String @id @default(uuid())
  saleId      String
  createdById String

  totalRefundAmount Decimal @db.Decimal(12, 2)

  sale      Sale @relation(fields: [saleId], references: [id])
  createdBy User @relation("ReturnCreatedBy", fields: [createdById], references: [id])

  items   ReturnItem[]
  refunds Refund[]

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([createdById])
  @@index([createdAt])
  @@map("returns")
}

model ReturnItem {
  id           String  @id @default(uuid())
  returnId     String
  saleItemId   String
  quantity     Int
  refundAmount Decimal @db.Decimal(12, 2)

  returnRecord ProductReturn @relation(fields: [returnId], references: [id])
  saleItem     SaleItem      @relation(fields: [saleItemId], references: [id])

  @@index([returnId])
  @@index([saleItemId])
}

model Refund {
  id     String        @id @default(uuid())
  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod

  saleId        String?
  reservationId String?
  returnId      String?
  exchangeId    String?

  createdById String

  sale         Sale?          @relation(fields: [saleId], references: [id])
  reservation  Reservation?   @relation(fields: [reservationId], references: [id])
  returnRecord ProductReturn? @relation(fields: [returnId], references: [id])
  exchange     Exchange?      @relation(fields: [exchangeId], references: [id])
  createdBy    User           @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([reservationId])
  @@index([returnId])
  @@index([exchangeId])
  @@index([createdAt])
}

model Exchange {
  id               String  @id @default(uuid())
  saleId           String
  saleItemId       String
  newProductId     String
  quantity         Int
  createdById      String
  differenceAmount Decimal @db.Decimal(12, 2)

  sale       Sale     @relation(fields: [saleId], references: [id])
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])
  newProduct Product  @relation(fields: [newProductId], references: [id])
  createdBy  User     @relation("ExchangeCreatedBy", fields: [createdById], references: [id])

  refunds Refund[]

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([saleItemId])
  @@index([createdById])
  @@index([createdAt])
}

model ExpenseCategory {
  id     String     @id @default(uuid())
  name   String     @unique
  status UserStatus @default(ACTIVE)

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id          String   @id @default(uuid())
  categoryId  String
  branchId    String?
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  expenseDate DateTime

  createdById String

  category  ExpenseCategory @relation(fields: [categoryId], references: [id])
  branch    Branch?         @relation(fields: [branchId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([branchId])
  @@index([expenseDate])
}
